// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider  = "postgresql"
url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Prisma MOdel

model Task{
  id Int  @id @default(autoincrement())
  taskName String
  dueDate   DateTime
  tags       String[]

}
